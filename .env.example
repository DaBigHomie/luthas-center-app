# Luthas Center for Excellence — Environment Variables
# Copy to .env.local and fill in values.  (.env* is gitignored.)
# NEXT_PUBLIC_* are exposed to the browser — never put secrets there.
#
# Legend:  [REQUIRED] needed to go live · [SETUP] one-time CLI/migration ·
#          [OPTIONAL] feature-gated / future · [TOOLING] re-run extraction only

# ─────────────────────────────────────────────────────────────────────
# Supabase — app runtime  [REQUIRED]
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Server-only (admin writes, seed, media upload) — NEVER expose:
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─────────────────────────────────────────────────────────────────────
# Supabase — CLI / migrations / storage upload  [SETUP]
# (used by `supabase link`, `db push`, and scripts/.../upload-to-storage.ts)
# ─────────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_PERSONAL_ACCESS_TOKEN
SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
# Storage bucket for migrated media (default: media)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=media

# ─────────────────────────────────────────────────────────────────────
# Site identity  [REQUIRED]
# (used by metadata, sitemap, robots, canonical/OG URLs)
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://luthascenter.damieus.app
NEXT_PUBLIC_SITE_NAME=Luthas Center for Excellence

# ─────────────────────────────────────────────────────────────────────
# Contact form email — Resend  [OPTIONAL: enables contact form delivery]
# ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=YOUR_RESEND_API_KEY
CONTACT_EMAIL=info@luthascenter.org
CONTACT_FROM_EMAIL=noreply@luthascenter.org

# ─────────────────────────────────────────────────────────────────────
# Donations  [OPTIONAL]
# v1 = manual CTA (Cash App / Zelle). Stripe is for later (native checkout).
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CASHAPP_HANDLE=$LuthasCenter
NEXT_PUBLIC_ZELLE_HANDLE=donate@luthascenter.org
# Future native Stripe donations:
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Legacy redirects  [OPTIONAL]
# Off by default. Set to 1 ONLY after luthascenter.com/.org is bought and
# pointed here, to enable the 301 map in src/middleware.ts.
# ─────────────────────────────────────────────────────────────────────
ENABLE_WP_REDIRECTS=0

# ─────────────────────────────────────────────────────────────────────
# Analytics  [OPTIONAL]
# ─────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────
# Vercel deploy  [OPTIONAL — only for non-interactive `vercel` CLI;
# the dashboard / Git integration does not need these]
# ─────────────────────────────────────────────────────────────────────
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────
# WordPress extraction  [TOOLING — only to RE-RUN scripts/extract against a
# MySQL container; not needed by the app. The original container is gone.]
# ─────────────────────────────────────────────────────────────────────
# WP_DB_HOST=127.0.0.1
# WP_DB_PORT=33061
# WP_DB_NAME=local
# WP_DB_USER=root
# WP_DB_PASSWORD=root

# ─────────────────────────────────────────────────────────────────────
# Test  [OPTIONAL] — port for the runtime smoke test (default 3100)
# ─────────────────────────────────────────────────────────────────────
# SMOKE_PORT=3100
